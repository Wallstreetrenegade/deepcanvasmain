# Public hostname only, without https:// or a trailing slash.
DOMAIN=deepcanvasai.dev

# PostgreSQL is private to the Docker network. Generate with: openssl rand -hex 32
POSTGRES_DB=deepcanvas
POSTGRES_USER=deepcanvas
POSTGRES_PASSWORD=

# Authentication must remain enabled in production.
DEEPCANVAS_REQUIRE_WEB_AUTH=true
DEEPCANVAS_ALLOW_SIGNUPS=false

# RingCentral server-side OAuth application.
RINGCENTRAL_SERVER=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_REDIRECT_URI=https://deepcanvasai.dev/integrations/ringcentral/callback
RINGCENTRAL_TOKEN_ENCRYPTION_KEY=
RINGCENTRAL_SHARED_USER_ID=

# Optional Google Calendar integration.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://deepcanvasai.dev/integrations/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Public Google Sheet CRM lead sync (CSV export URL, not the browser edit URL).
GOOGLE_SHEETS_LEADS_CSV_URL=
GOOGLE_SHEETS_CRM_TEAM_ID=

# Optional integrations and model providers. Add only the values used by the office.
DOCUSEAL_URL=
DOCUSEAL_API_KEY=
OPENAI_API_KEY=
